// Auth + learning progress. The course catalog itself is static-generated from
// YouTube (src/lib/catalog.generated.ts), so courseId/lessonId here are the
// generated string ids, not foreign keys.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String?  // null for OAuth-only (Google) accounts
  image        String?
  createdAt    DateTime @default(now())

  sessions     Session[]
  enrollments  Enrollment[]
  progress     Progress[]
  payments     Payment[]
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Enrollment {
  id         String   @id @default(cuid())
  userId     String
  courseId   String
  enrolledAt DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId])
}

model Progress {
  id        String   @id @default(cuid())
  userId    String
  courseId  String
  lessonId  String
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId])
}

// ─── Catalog (synced from YouTube, curated by the owner in Course Studio) ───

model Course {
  id            String   @id // = YouTube playlist id (stable across re-syncs)
  slug          String   @unique

  // Synced from YouTube (overwritten each sync)
  ytTitle       String
  ytDescription String   @default("")
  thumbnail     String   @default("")
  views         Int      @default(0)
  syncedAt      DateTime @default(now())

  // Owner-editable overrides (Course Studio; preserved across syncs)
  published     Boolean  @default(false)
  track         String   @default("OTHER") // CERTIFICATION | CODING | OTHER
  level         String   @default("")
  code          String?
  order         Int      @default(0)
  priceInr      Int      @default(0) // 0 = free
  mrpInr        Int      @default(0)
  titleOverride String?
  descOverride  String?
  examInfo      String?  // certification exam details (passing %, fees, format)
  mockTestUrl   String?  // instructor-attached mock test / practice link

  createdAt     DateTime @default(now())
  lessons       Lesson[]
}

model Lesson {
  id            String  @id // = `${courseId}_${ytVideoId}` (stable)
  courseId      String
  ytVideoId     String
  title         String
  titleOverride String?  // admin-set; preserved across syncs
  thumbnail     String  @default("")
  seconds       Int     @default(0)
  views         Int     @default(0)
  position      Int     @default(0)
  manuallyAdded Boolean @default(false) // not removed on re-sync

  course    Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, ytVideoId])
  @@index([courseId])
}

// Razorpay order lifecycle, one row per checkout attempt. Enrollment is only
// granted once the signature on the paid row is verified (see api/payments/verify).
model Payment {
  id          String   @id @default(cuid())
  userId      String
  courseId    String
  orderId     String   @unique
  paymentId   String?
  amountPaise Int
  status      String   @default("created") // created | paid | failed
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Admin allowlist (by email, so they can be granted access before signing up).
// The ADMIN_EMAILS env list is the always-on "owner" bootstrap on top of this.
model Admin {
  id        String   @id @default(cuid())
  email     String   @unique
  addedBy   String?
  createdAt DateTime @default(now())
}

model Channel {
  id          String   @id @default("singleton")
  title       String   @default("Tech Courses")
  subscribers Int      @default(0)
  totalViews  Int      @default(0)
  videoCount  Int      @default(0)
  syncedAt    DateTime @default(now())
}

// ─── Visual CMS editor: owner-editable marketing content ───
// Two rows only: id = 'draft' (autosave target) and 'live' (public site reads
// this). `data` is the full SiteContent tree (see src/types/content.ts).
model SiteContent {
  id        String   @id // 'draft' | 'live'
  data      Json
  updatedAt DateTime @updatedAt
}

// Append-only log of published versions — powers the editor's History panel.
model SiteContentHistory {
  id        Int      @id @default(autoincrement())
  message   String
  data      Json
  createdAt DateTime @default(now())

  @@index([createdAt])
}
